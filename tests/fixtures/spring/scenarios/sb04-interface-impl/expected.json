      "evidence": [
        {
          "repo": "acme/ledger",
          "path": "src/main/java/com/acme/ledger/api/InvoiceController.java",
          "contains": "import com.acme.ledger.service.Pricing;"
        },
        {
          "repo": "acme/ledger",
          "path": "src/main/java/com/acme/ledger/api/InvoiceController.java",
          "contains": "return pricing.price(id);"
        }
      ]

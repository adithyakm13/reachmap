  "change": {
    "kind": "compare",
    "base": "main",
    "head": "scenario/sb04-interface-impl"
  },
  "explains": "PricingImpl.price changes its multiplier. PricingImpl implements Pricing, an interface of the repository, and a caller of the interface reaches the class: InvoiceController imports Pricing and spells price in its handler price (pricing.price(id)), so that handler is reached through the interface, with the import of Pricing as the first hop of the chain. In the class, tax calls price, so tax is reached by the closure of the file, but nothing spells tax: no other route is reached. InvoiceControllerTest imports PricingImpl and uses InvoiceController, so it is a unit test. Nothing in the web client calls the price route.",
  "complete_for": [
    "changed_symbol",
    "caller",
    "unit_test",
    "route",
    "screen",
    "http_edge",
    "finding"
  ],
  "must_find": [
    {
      "type": "changed_symbol",
      "repo": "acme/ledger",
      "path": "src/main/java/com/acme/ledger/service/PricingImpl.java",
      "symbol": "PricingImpl.price",
      "evidence": [
        {
          "repo": "acme/ledger",
          "path": "src/main/java/com/acme/ledger/service/PricingImpl.java",
          "contains": "return id.length() * 12;"
        }
      ]
    },
    {
      "type": "caller",
      "repo": "acme/ledger",

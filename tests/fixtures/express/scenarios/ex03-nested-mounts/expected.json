{
  "schema": 1,
  "id": "ex03-nested-mounts",
  "repo": "ex/orders",
  "change": {
    "kind": "compare",
    "base": "main",
    "head": "scenario/ex03-nested-mounts"
  },
  "explains": "stats in src/controllers/admin.ts adds a timestamp. src/routes/admin.ts imports stats and wires it in router.get(\"/stats\", stats); the router is the named export router. src/routes/index.ts imports the module as a namespace (import * as admin) and mounts admin.router with apiRouter.use(`${API_VERSION}/admin`, admin.router): a template literal of the constant API_VERSION, \"/v1\". apiRouter is mounted by app.use(API_PREFIX, apiRouter), API_PREFIX being \"/api\" in src/config.ts, imported by name. The route is composed from the router outwards: GET /api/v1/admin/stats, with the route line and the two mount lines as evidence. The client calls ADMIN_STATS_URL in fetchStats, so the http edge goes to the route and StatsScreen, mounted at /stats, is reached (it also calls fetchInvoices, a different URL).",
  "complete_for": [
    "changed_symbol",
    "route",
    "screen",
    "http_edge",
    "finding"
  ],
  "must_find": [
    {
      "type": "changed_symbol",
      "repo": "ex/orders",
      "path": "src/controllers/admin.ts",
      "symbol": "stats"
    },
    {
      "type": "route",
      "repo": "ex/orders",
      "method": "GET",
      "path": "/api/v1/admin/stats",
      "evidence": [
        {
          "repo": "ex/orders",
          "path": "src/routes/admin.ts",
          "contains": "router.get(\"/stats\", stats);"
        },
        {
          "repo": "ex/orders",
          "path": "src/routes/index.ts",
          "contains": "apiRouter.use(`${API_VERSION}/admin`, admin.router);"
        },
        {
          "repo": "ex/orders",
          "path": "src/app.ts",
          "contains": "app.use(API_PREFIX, apiRouter);"
        }
      ]
    },
    {
      "type": "http_edge",
      "from": {
        "repo": "ex/web",
        "path": "src/services/admin.ts",
        "contains": "return apiGet(ADMIN_STATS_URL);"
      },
      "via": [
        {
          "repo": "ex/web",
          "path": "src/api/endpoints.ts",
          "contains": "export const ADMIN_STATS_URL = \"/api/v1/admin/stats\";"
        }
      ],
      "to": {
        "repo": "ex/orders",
        "method": "GET",
        "path": "/api/v1/admin/stats",
        "evidence": [
          {
            "repo": "ex/orders",
            "path": "src/routes/admin.ts",
            "contains": "router.get(\"/stats\", stats);"
          },
          {
            "repo": "ex/orders",
            "path": "src/routes/index.ts",
            "contains": "apiRouter.use(`${API_VERSION}/admin`, admin.router);"
          },
          {
            "repo": "ex/orders",
            "path": "src/app.ts",
            "contains": "app.use(API_PREFIX, apiRouter);"
          }
        ]
      }
    },
    {
      "type": "screen",
      "repo": "ex/web",
      "route": "/stats",
      "chain": [
        {
          "repo": "ex/orders",
          "path": "src/routes/admin.ts",
          "contains": "import { stats } from \"../controllers/admin\";"
        },
        {
          "repo": "ex/web",
          "path": "src/services/admin.ts",
          "contains": "return apiGet(ADMIN_STATS_URL);"
        },
        {
          "repo": "ex/web",
          "path": "src/screens/StatsScreen.tsx",
          "contains": "import { fetchStats, fetchInvoices } from \"@/services/admin\";"
        },
        {
          "repo": "ex/web",
          "path": "src/routes.tsx",
          "contains": "import StatsScreen from \"./screens/StatsScreen\";"
        },
        {
          "repo": "ex/web",
          "path": "src/routes.tsx",
          "contains": "<Route path=\"/stats\" element={<StatsScreen />} />"
        }
      ]
    }
  ],
  "must_exclude": [
    {
      "type": "route",
      "repo": "ex/orders",
      "method": "GET",
      "path": "/api/v1/reports/monthly",
      "why": "another router"
    }
  ],
  "not_established": []

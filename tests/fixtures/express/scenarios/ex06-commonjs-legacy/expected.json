{
  "schema": 1,
  "id": "ex06-commonjs-legacy",
  "repo": "ex/orders",
  "change": {
    "kind": "compare",
    "base": "main",
    "head": "scenario/ex06-commonjs-legacy"
  },
  "explains": "getInvoice in src/controllers/invoices.ts wraps the invoice. src/legacy/invoices.js is CommonJS: const { getInvoice, listInvoices } = require(\"../controllers/invoices\"), and it exports its router with module.exports = router. A require is never narrowed by name (the adapter does not know what a CommonJS module exports), so both handlers it takes are reached: GET /legacy/invoices (listInvoices) and GET /legacy/invoices/{invoiceId} (getInvoice). src/legacy/index.js mounts the router it requires with router.use(\"/invoices\", invoices) and exports its own router, and src/app.ts mounts that with app.use(\"/legacy\", require(\"./legacy\")): an inline require. The paths are /legacy/invoices and /legacy/invoices/{invoiceId} (no API prefix: the legacy router is not under apiRouter). The client calls INVOICES_URL, \"/legacy/invoices\", in fetchInvoices: the http edge goes to GET /legacy/invoices only (the other route has one more segment) and StatsScreen, mounted at /stats, is reached.",
  "complete_for": [
    "changed_symbol",
    "route",
    "screen",
    "http_edge",
    "finding"
  ],
  "must_find": [
    {
      "type": "changed_symbol",
      "repo": "ex/orders",
      "path": "src/controllers/invoices.ts",
      "symbol": "getInvoice"
    },
    {
      "type": "route",
      "repo": "ex/orders",
      "method": "GET",
      "path": "/legacy/invoices",
      "evidence": [
        {
          "repo": "ex/orders",
          "path": "src/legacy/invoices.js",
          "contains": "router.get(\"/\", listInvoices);"
        },
        {
          "repo": "ex/orders",
          "path": "src/legacy/index.js",
          "contains": "router.use(\"/invoices\", invoices);"
        },
        {
          "repo": "ex/orders",
          "path": "src/app.ts",
          "contains": "app.use(\"/legacy\", require(\"./legacy\"));"
        }
      ]
    },
    {
      "type": "route",
      "repo": "ex/orders",
      "method": "GET",
      "path": "/legacy/invoices/{invoiceId}",
      "evidence": [
        {
          "repo": "ex/orders",
          "path": "src/legacy/invoices.js",
          "contains": "router.get(\"/:invoiceId\", getInvoice);"
        },
        {
          "repo": "ex/orders",
          "path": "src/legacy/index.js",
          "contains": "router.use(\"/invoices\", invoices);"
        },
        {
          "repo": "ex/orders",
          "path": "src/app.ts",
          "contains": "app.use(\"/legacy\", require(\"./legacy\"));"
        }
      ]
    },
    {
      "type": "http_edge",
      "from": {
        "repo": "ex/web",
        "path": "src/services/admin.ts",
        "contains": "return apiGet(INVOICES_URL);"
      },
      "via": [
        {
          "repo": "ex/web",
          "path": "src/api/endpoints.ts",
          "contains": "export const INVOICES_URL = \"/legacy/invoices\";"
        }
      ],
      "to": {
        "repo": "ex/orders",
        "method": "GET",
        "path": "/legacy/invoices",
        "evidence": [
          {
            "repo": "ex/orders",
            "path": "src/legacy/invoices.js",
            "contains": "router.get(\"/\", listInvoices);"
          },
          {
            "repo": "ex/orders",
            "path": "src/legacy/index.js",
            "contains": "router.use(\"/invoices\", invoices);"
          },
          {
            "repo": "ex/orders",
            "path": "src/app.ts",
            "contains": "app.use(\"/legacy\", require(\"./legacy\"));"
          }
        ]
      }
    },
    {
      "type": "screen",
      "repo": "ex/web",
      "route": "/stats",
      "chain": [
        {
          "repo": "ex/orders",
          "path": "src/legacy/invoices.js",
          "contains": "const { getInvoice, listInvoices } = require(\"../controllers/invoices\");"
        },
        {
          "repo": "ex/web",
          "path": "src/services/admin.ts",
          "contains": "return apiGet(INVOICES_URL);"
        },
        {
          "repo": "ex/web",
          "path": "src/screens/StatsScreen.tsx",
          "contains": "import { fetchStats, fetchInvoices } from \"@/services/admin\";"
        },
        {

            "path": "services/billing/app/routers/billing.py",
            "contains": "billing_router.include_router(settlements_router, prefix=\"/settlements\")"
          },
          {
            "repo": "acme/api",
            "path": "services/billing/app/api.py",
            "contains": "api_router.include_router(billing_router, prefix=\"/billing\")"
          },
          {

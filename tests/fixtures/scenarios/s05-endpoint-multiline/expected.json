          "contains": "import { fetchSettlementSummary } from \"../api\";"
        }
      ]
    },
    {
      "type": "http_edge",
      "from": {
        "repo": "acme/web",
        "path": "src/modules/billing/api.ts",
        "contains": "apiGet<SettlementSummary>(SETTLEMENT_SUMMARY_URL)"
      },
      "via": [
        {
          "repo": "acme/web",
          "path": "src/api/endpoints.ts",
          "contains": "export const SETTLEMENT_SUMMARY_URL ="
        },
        {
          "repo": "acme/web",
          "path": "src/api/endpoints.ts",
          "contains": "\"/api/billing/settlements/summary\""
        }
      ],
      "to": {
        "repo": "acme/api",
        "method": "GET",
        "path": "/api/billing/settlements/summary",
        "evidence": [
          {
            "repo": "acme/api",

      "chain": [
        {
          "repo": "acme/web",
          "path": "src/modules/billing/pages/SettlementsPage.tsx",
          "contains": "import { fetchSettlementSummary } from \"../api\";"
        },
        {
          "repo": "acme/web",
          "path": "src/modules/billing/routes.tsx",
          "contains": "import SettlementsPage from \"./pages/SettlementsPage\";"
        },
        {
          "repo": "acme/web",
          "path": "src/modules/billing/routes.tsx",
          "contains": "<Route path=\"/billing/settlements\" element={<SettlementsPage />} />"
        }
      ]
    }
  ],
  "must_exclude": [

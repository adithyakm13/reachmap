{
  "schema": 1,
  "id": "s21-hop-cap",
  "repo": "acme/contracts",
  "change": {
    "kind": "compare",
    "base": "main",
    "head": "scenario/s21-hop-cap"
  },
  "explains": "The change is the one in s11 (Invoice.settlement_reference becomes required) but the workspace is limited to hops = 1. The first edges past acme/contracts are the package and contract edges to acme/api and acme/worker, which are allowed: api reads the field in settlement.py and the worker reads it in settlement_sync.py, and the api route that reaches the read is resolved inside the api (GET /api/billing/settlements/summary, composed from /api + /billing + /settlements + /summary). Both consumers pin below the unreleased change, so exposure comes on adoption. The http edge between acme/web and acme/api (declared from acme/web to acme/api, followed here from the api side) is the second edge, beyond the cap, so the web screen /billing/settlements is not listed and the report records hop_cap naming the edge. A cap is a stated limit, not a failed read, so it is not blocking, but it must be said: the missing screen is not an absence.",
  "complete_for": [
    "changed_symbol",
    "contract_read",
    "route",
    "http_edge",
    "screen",
    "consumer"
  ],
  "must_find": [

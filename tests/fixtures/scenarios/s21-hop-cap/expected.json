          "contains": "from acme_contracts.models.invoice import Invoice"
        },
        {
          "repo": "acme/worker",
          "path": "worker/tasks/settlement_sync.py",
          "contains": "return invoice.settlement_reference or f\"pending-{invoice.id}\""
        }
      ]

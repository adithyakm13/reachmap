        },
        {
          "repo": "acme/api",
          "path": "services/billing/app/services/settlement.py",
          "contains": "if invoice.settlement_reference is None:"
        }
      ]
    },
    {
      "type": "contract_read",
      "repo": "acme/worker",
      "path": "worker/tasks/settlement_sync.py",
      "symbol": "sync_invoice",
      "evidence": [
        {
          "repo": "acme/worker",

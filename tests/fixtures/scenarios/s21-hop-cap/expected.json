      "repo": "acme/contracts",
      "path": "contracts/models/invoice.py",
      "symbol": "Invoice.settlement_reference"
    },
    {
      "type": "contract_read",
      "repo": "acme/api",
      "path": "services/billing/app/services/settlement.py",

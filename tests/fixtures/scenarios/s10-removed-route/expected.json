        "path": "src/modules/billing/api.ts",
        "contains": "apiGet<AuditEntry[]>(AUDIT_LOG_URL)"
      },
      "via": [
        {
          "repo": "acme/web",
          "path": "src/api/endpoints.ts",
          "contains": "export const AUDIT_LOG_URL = \"/api/billing/audit-log\";"
        }
      ],
      "to": {
        "repo": "acme/api",
        "method": "GET",
        "path": "/api/billing/audit-log",
        "removed": true,
        "evidence": [
          {
            "repo": "acme/api",
            "path": "services/billing/app/routers/billing.py",
            "contains": "@billing_router.get(\"/audit-log\")",
            "at": "base"
          },
          {
            "repo": "acme/api",
            "path": "services/billing/app/api.py",

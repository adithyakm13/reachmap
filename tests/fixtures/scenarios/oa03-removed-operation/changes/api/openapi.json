{
  "openapi": "3.0.3",
  "info": {
    "title": "Ledger API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://ledger.example.invalid/v1"
    }
  ],
  "paths": {
    "/invoices": {
      "get": {
        "operationId": "listInvoices",
        "tags": [
          "invoices"
        ],
        "summary": "List invoices",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Invoice"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createInvoice",
        "tags": [
          "invoices"
        ],
        "summary": "Create an invoice",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewInvoice"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{invoiceId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/InvoiceId"
        }
      ],
      "get": {
        "operationId": "getInvoice",
        "tags": [
          "invoices"
        ],
        "summary": "Fetch one invoice",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "operationId": "voidInvoice",
        "tags": [
          "invoices"
        ],
        "summary": "Void an invoice",
        "responses": {
          "204": {
            "description": "voided"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/statements/{statementId}/download": {
      "get": {
        "operationId": "downloadStatement",
        "tags": [
          "statements"
        ],
        "summary": "Download a statement as a PDF",
        "parameters": [
          {
            "name": "statementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "the PDF",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/ping": {
      "get": {
        "operationId": "get",
        "tags": [
          "system"
        ],
        "summary": "Answer when the service is up",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/reports": {
      "get": {
        "operationId": "list",
        "tags": [
          "system"
        ],
        "summary": "List the available reports",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "InvoiceId": {
        "name": "invoiceId",
        "in": "path",
        "required": true,
        "description": "The invoice number",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "no such object",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Invoice": {
        "type": "object",
        "required": [
          "id",
          "total"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "paid",
              "void"
            ]
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          }
        }
      },
      "Customer": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "invoices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Invoice"
            }
          }
        }
      },
      "Money": {
        "type": "object",
        "required": [
          "amount"
        ],
        "properties": {
          "amount": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "NewInvoice": {
        "type": "object",
        "required": [
          "customerId",
          "total"
        ],
        "properties": {
          "customerId": {
            "type": "string"
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          }
        }
      }
    }
  }
}
